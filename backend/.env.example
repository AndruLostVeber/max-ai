# ─────────────────────────────────────────────────────────────────
# Max AI — пример конфигурации
# Демо-версия: https://maxeditor.ru
# ─────────────────────────────────────────────────────────────────

# ── AI API (OpenAI-совместимый) ───────────────────────────────────
MWS_BASE_URL=https://api.gpt.mws.ru/v1
MWS_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Модели ───────────────────────────────────────────────────────
MODEL_TEXT=mws-gpt-alpha
MODEL_CODE=qwen3-coder-480b-a35b
MODEL_LONG=qwen2.5-72b-instruct
MODEL_EMBED=nvidia/nv-embedqa-e5-v5
MODEL_RESEARCH_PLANNER=meta/llama-3.1-8b-instruct
MODEL_RESEARCH_EXTRACTOR=qwen2.5-72b-instruct
MODEL_RESEARCH_WRITER=qwen2.5-72b-instruct

# ── База данных ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/mirea

# ── Кэш ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Auth ─────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── ASR / TTS ────────────────────────────────────────────────────
# Groq Whisper (опционально, иначе используется локальный ASR)
GROQ_API_KEY=
GROQ_PROXY=

# Голос TTS (Microsoft edge-tts)
TTS_VOICE=ru-RU-SvetlanaNeural

# ── Deep Research ─────────────────────────────────────────────────
RESEARCH_SAFE_MODE=false
RESEARCH_LLM_CONCURRENCY=2
RESEARCH_SUBQUERY_COUNT=4
RESEARCH_SEARCH_RESULTS=3
RESEARCH_CONCURRENCY=4
RESEARCH_PARSE_TIMEOUT=12
RESEARCH_SYNTHESIS_TIMEOUT=75
RESEARCH_MAX_SOURCES=8
RESEARCH_MAX_CONTEXT_CHARS=12000

# ── Лимиты ───────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
MAX_FILE_SIZE_MB=50
CONTEXT_MAX_TOKENS=8000
